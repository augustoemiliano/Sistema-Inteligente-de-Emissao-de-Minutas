# ------------------------------------------------------------------
# Copie para .env e ajuste. Os valores abaixo servem para DEV LOCAL.
# ------------------------------------------------------------------

# App
ENVIRONMENT=development
PROJECT_NAME=Sistema Inteligente de Emissão de Minutas com IA
API_V1_PREFIX=/api/v1
# Vírgulas, não JSON. Inclui 8010 (API via Compose) e 8000 (uvicorn local típico).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8010,http://127.0.0.1:8010,http://localhost:8000,http://127.0.0.1:8000

# Segurança — gere uma chave forte: python -c "import secrets; print(secrets.token_hex(32))"
# (esta chave de exemplo é recusada quando ENVIRONMENT=production)
SECRET_KEY=change-me-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
BCRYPT_ROUNDS=12

# Banco — opção A: Postgres do docker-compose (porta 5437 no host)
DATABASE_URL=postgresql+psycopg://minutas:minutas@127.0.0.1:5437/minutas_db
DATABASE_URL_SYNC=postgresql+psycopg2://minutas:minutas@127.0.0.1:5437/minutas_db
# Banco — opção B: SQLite, sem instalar nada
# DATABASE_URL=sqlite+aiosqlite:///./minutas.db
# DATABASE_URL_SYNC=sqlite:///./minutas.db

# Redis / Celery — com docker-compose publicado em 6380 no host
REDIS_URL=redis://127.0.0.1:6380/0
CELERY_BROKER_URL=redis://127.0.0.1:6380/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6380/0
# true = executa as tasks (PDF/OCR) no próprio processo da API — dispensa Redis e worker
CELERY_TASK_ALWAYS_EAGER=false

# IA — auto: usa OpenAI se OPENAI_API_KEY estiver preenchida; senão provider fake (offline)
AI_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=30
AI_MAX_INPUT_CHARS=20000

# Arquivos
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=10
GENERATED_DOCUMENTS_DIR=generated_documents
LOG_DIR=logs

# PDF — auto: wkhtmltopdf se existir no sistema, senão ReportLab (puro Python)
PDF_ENGINE=auto
WKHTMLTOPDF_PATH=

# OCR — Tesseract é opcional (PDFs com texto não precisam). Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_LANGUAGE=por
